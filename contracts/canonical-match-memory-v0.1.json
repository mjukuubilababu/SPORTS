{
  "contract_id": "CANONICAL_MATCH_MEMORY_V0_1",
  "version": "v0.1",
  "status": "STEP_1_IMPLEMENTED",
  "scope": "GLOBAL_FOOTBALL_LEAGUE_AGNOSTIC",
  "purpose": "Materialize a governed, immutable per-match memory envelope from existing canonical truth and related evidence without replacing Gate1 truth ownership or introducing hindsight.",
  "depends_on": {
    "pattern_intelligence_contract": "PATTERN_INTELLIGENCE_CONTRACT_V0_1",
    "canonical_truth_store": "CANONICAL_HISTORICAL_TRUTH_STORE_V0_1",
    "p002": "FROZEN_RESEARCH_RULE",
    "truth_owner": "GATE1_EXISTING_OWNER",
    "reasoning_owner": "packages/intelligence-engine"
  },
  "construction_policy": {
    "preserve_existing_system": true,
    "delete_existing_artifact_without_explicit_user_approval": false,
    "replace_existing_artifact_without_explicit_user_approval": false,
    "conflict_requires_explicit_user_decision": true,
    "step_1_additive_only": true
  },
  "memory_semantics": {
    "authoritative_truth_owner": "GATE1",
    "match_memory_is_derived_materialized_view": true,
    "match_memory_may_not_rewrite_truth": true,
    "one_memory_identity_per_canonical_match_id": true,
