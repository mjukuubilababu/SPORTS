{
  "capability": "prediction-http-api",
  "version": "v0.1",
  "transport": "HTTP_JSON",
  "endpoints": [
    {
      "method": "GET",
      "path": "/health",
      "purpose": "service health and governance state"
    },
    {
      "method": "POST",
      "path": "/v1/predict",
      "purpose": "invoke canonical multi-model probability orchestrator"
    },
    {
      "method": "GET",
      "path": "/v1/predictions/{snapshotId}/lineage",
      "purpose": "read-only exact source-to-prediction lineage attestation for downstream consumers"
    }
  ],
  "predict_required_fields": [
    "eventId",
    "market",
    "selection",
    "kickoffAt",
    "models",
    "offeredOdds",
    "confidence"
  ],
  "model_logic_duplicated_in_api": false,
  "market_to_model_circularity_forbidden": true,
  "max_body_bytes": 1048576,
  "cache_control": "no-store",
  "capital_state": "LOCKED",
  "real_money": "NO",
  "postgres_persistence": {
    "version": "v0.2",
    "required_lineage_input_when_enabled": [
      "persistenceLineage.frozenSignalSnapshotId",
      "persistenceLineage.frozenSignalFingerprint"
    ],
    "exact_event_bound_frozen_signal_fk": true,
    "atomic_prediction_and_lineage_transaction": true,
    "dedicated_pool_client": true,
    "fail_closed": true,
    "parallel_prediction_store": false,
    "downstream_lineage_attestation": {
      "version": "v0.1",
      "chain": [
        "PREDICTION_SNAPSHOT",
        "FROZEN_SIGNAL",
        "MODEL_SNAPSHOT",
        "FEATURE_SNAPSHOT",
        "SOURCE_PROVENANCE"
      ],
      "exact_event_bound": true,
      "input_and_output_hashes_recomputed": true,
      "prematch_eligibility_rechecked": true,
      "settlement_separate": true,
      "legacy_unlinked_rows_fail_closed": true,
      "authorizes_validation": false,
      "authorizes_execution": false,
      "truth_owner": "GATE1",
      "capital_owner": "GATE6",
      "capital_state": "LOCKED",
      "real_money": "NO",
      "all_persisted_fingerprints_recomputed": true,
      "complete_contiguous_feature_set_required": true,
      "model_and_signal_kickoff_must_match": true,
      "model_freeze_must_not_follow_signal_freeze": true,
      "feature_payload_upgrade_policy": "LEGACY_NULL_FAIL_CLOSED",
      "reference_payload_hash_semantics": "RAW_STRING_OTHERWISE_STABLE_JSON"
    }
  }
}
